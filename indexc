const labelPlugin={
  id:'customLabels',
  afterDraw(chart){
    const ctx=chart.ctx;
    ctx.save();
    chart.data.datasets.forEach((ds,di)=>{
      if(ds.type!=='bar') return;  // 막대만
      const meta=chart.getDatasetMeta(di);
      if(meta.hidden) return;
      meta.data.forEach((el,i)=>{
        const val=ds.data[i];
        if(val===0||val==null) return;
        const barH=el.base-el.y;  // 막대 높이(px)
        if(barH<14) return;       // 막대 너무 낮으면 생략
        ctx.font='bold 11px Pretendard,-apple-system,sans-serif';
        ctx.fillStyle='#ffffff';
        ctx.textAlign='center';
        ctx.textBaseline='middle';
        ctx.fillText(val+'%', el.x, el.y+barH/2);  // 막대 안쪽 중앙
      });
    });
    // 꺾은선 수치는 위쪽
    chart.data.datasets.forEach((ds,di)=>{
      if(ds.type!=='line') return;
      const meta=chart.getDatasetMeta(di);
      if(meta.hidden) return;
      meta.data.forEach((el,i)=>{
        const val=ds.data[i];
        if(val==null) return;
        ctx.font='bold 11px Pretendard,-apple-system,sans-serif';
        ctx.fillStyle='#1B5E34';
        ctx.textAlign='center';
        ctx.textBaseline='bottom';
        ctx.fillText(String(val), el.x, el.y-8);
      });
    });
    ctx.restore();
  }
};
Chart.register(labelPlugin);

let curWeek='w1', curCell='1셀';
const charts={};

function getPrev(wk){const i=WEEK_KEYS.indexOf(wk);return i>0?WEEK_KEYS[i-1]:null;}
function pc(p){return p>=5?'pr':p>=3?'po':'pg';}
function ac(a){return a<4.4?'avg-bad':a<4.6?'avg-ok':'avg-good';}

function render(){
  const wk=curWeek, cell=curCell;
  const prev=getPrev(wk);
  const wLabel=WEEK_LABELS[WEEK_KEYS.indexOf(wk)];
  const cells=['1셀','2셀','3셀'];
  const chartAvgs=cells.map(c=>CELL_WEEK[c][wk].avg);
  const chartPcts=cells.map(c=>CELL_WEEK[c][wk].pct);
  const chartTotals=cells.map(c=>CELL_WEEK[c][wk].total);
  const chartLows=cells.map(c=>CELL_WEEK[c][wk].low);

  // 꺾은선과 막대 겹침 방지:
  // avg 범위 4.0~5.1 → y1
  // pct는 최대값 기준으로 y2 설정, 막대가 y1 선 아래 영역에만 오도록 y2max 조정
  const maxPct=Math.max(...chartPcts);
  // y2max: 막대가 차트 하단 40% 안에 들어오도록 → maxPct / 0.4 이상
  const y2max=Math.max(Math.ceil(maxPct/0.35), 8);

  // 셀 버튼
  const cellBtns=cells.map(c=>{
    const cw=CELL_WEEK[c][wk];
    return `<button class="cell-btn${c===cell?' active':''}" onclick="selectCell('${c}')">
      <div class="cb-l"><div class="cb-dot"></div><div class="cb-name">${c}</div></div>
      <div class="cb-r"><div class="cb-avg">${cw.avg}점</div><div class="cb-sub">1-2점 ${cw.pct}% · ${CELL_STORES[c].length}개 매장</div></div>
    </button>`;
  }).join('');

  // 테이블
  const stores=[...CELL_STORES[cell]].sort((a,b)=>STORE_WEEK[b][wk].p-STORE_WEEK[a][wk].p);
  let rows='';
  stores.forEach(store=>{
    const sw=STORE_WEEK[store][wk], sp=prev?STORE_WEEK[store][prev]:null;
    const bw=Math.min(sw.p/20*90,90);
    let dc='';
    if(wk!=='w1'&&sp){
      const d=+(sw.p-sp.p).toFixed(1);
      dc=d>0?`<span class="dcu">▲${Math.abs(d)}%p</span>`:d<0?`<span class="dcd">▼${Math.abs(d)}%p</span>`:`<span class="dce">-</span>`;
    }
    const rvCnt=(REVIEWS_BY_WEEK[store]||{})[wk]?.length||0;
    rows+=`<tr onclick="openDrawer('${store.replace(/'/g,"\'")}','${wk}')">
      <td class="store-nm">${store}</td>
      <td><span class="low-n">${sw.l}건</span><span class="tot-n"> / ${sw.t}건</span></td>
      <td><div class="bar-wrap"><div class="bar-bg" style="width:${bw}px"></div><span class="pct-n ${pc(sw.p)}">${sw.p}%</span>${dc}</div></td>
      <td><span class="${ac(sw.a)}">${sw.a}</span></td>
      <td>${rvCnt>0?`<button class="rv-btn">📋 ${rvCnt}건</button>`:'—'}</td>
    </tr>`;
  });

  document.getElementById('main-content').innerHTML=`
    <div class="section">
      <div class="sec-title">📊 ${wLabel} 셀별 평균 평점 &amp; 1-2점 비율<span class="sec-sub">3개 셀 비교 · 아래에서 셀 선택 시 매장 테이블 변경</span></div>
      <div class="chart-wrap"><canvas id="cell-chart"></canvas></div>
    </div>
    <div class="section">
      <div class="sec-title" style="margin-bottom:12px">셀 선택</div>
      <div class="cell-selector">${cellBtns}</div>
    </div>
    <div class="section">
      <div class="sec-title">😀 ${wLabel} ${cell} 매장별 현황<span class="sec-sub">저평점 비율순 · 행 클릭 시 리뷰</span></div>
      <table>
        <thead><tr><th>매장명</th><th>저평점</th><th>저평점 비율${wk!=='w1'?' (▲▼ 전주)':''}</th><th>평균 평점</th><th>리뷰</th></tr></thead>
        <tbody>${rows}</tbody>
      </table>
    </div>`;

  setTimeout(()=>drawChart(wk,chartAvgs,chartPcts,chartTotals,chartLows,y2max),30);
}

function drawChart(wk,avgs,pcts,totals,lows,y2max){
  const canvas=document.getElementById('cell-chart');
  if(!canvas) return;
  if(charts[wk]){charts[wk].destroy();delete charts[wk];}
  charts[wk]=new Chart(canvas.getContext('2d'),{
    data:{
      labels:['1셀','2셀','3셀'],
      datasets:[
        {
          type:'bar', label:'1-2점 비율(%)', data:pcts,
          backgroundColor:'rgba(92,184,122,0.75)',  // 단일 컬러
          borderColor:'rgba(45,125,70,0.9)',
          borderWidth:1.5, borderRadius:6,
          yAxisID:'y2', order:2,
          barPercentage:0.45, categoryPercentage:0.6
        },
        {
          type:'line', label:'평균 평점', data:avgs,
          borderColor:'#1B5E34', backgroundColor:'rgba(45,125,70,0.06)',
          borderWidth:2.5,
          pointBackgroundColor:'#2D7D46', pointRadius:6, pointHoverRadius:8,
          tension:0.3, yAxisID:'y1', order:1
        }
      ]
    },
    options:{
      responsive:true, maintainAspectRatio:false,
      animation:{duration:500},
      interaction:{mode:'index',intersect:false},
      plugins:{
        legend:{position:'top',labels:{font:{size:11},boxWidth:12,padding:16}},
        tooltip:{callbacks:{
          afterBody:(items)=>{
            const i=items[0].dataIndex;
            return[`총 리뷰: ${totals[i]}건`,`저평점: ${lows[i]}건`];
          }
        }}
      },
      scales:{
        y1:{
          type:'linear', position:'left',
          min:4.0, max:5.2,
          title:{display:true,text:'평균 평점',font:{size:10},color:'#1B5E34'},
          ticks:{font:{size:10},color:'#1B5E34',stepSize:0.2}
        },
        y2:{
          type:'linear', position:'right',
          min:0, max:y2max,
          title:{display:true,text:'1-2점 비율(%)',font:{size:10},color:'#4CAF6E'},
          ticks:{font:{size:10},callback:v=>v+'%',color:'#4CAF6E'},
          grid:{drawOnChartArea:false}
        },
        x:{ticks:{font:{size:13},color:'#1A2E1A',padding:6}}
      }
    }
  });
}

function selectCell(c){curCell=c;render();}
function openDrawer(store,wk){
  const reviews=(REVIEWS_BY_WEEK[store]||{})[wk]||[];
  document.getElementById('d-title').textContent=store;
  document.getElementById('d-wtag').textContent=WEEK_LABELS[WEEK_KEYS.indexOf(wk)]+' 저평점 리뷰';
  document.getElementById('d-body').innerHTML=reviews.length===0
    ?`<div class="no-rv">✅ 해당 주차 저평점 리뷰 없음</div>`
    :reviews.map(r=>`<div class="rv"><div class="rv-meta"><span class="sc sc${r.score}">${r.score}점</span><span class="rv-date">${r.date}</span></div><div class="rv-txt">${r.content}</div></div>`).join('');
  document.getElementById('overlay').classList.add('open');
  document.getElementById('drawer').classList.add('open');
}
function closeDrawer(){
  document.getElementById('overlay').classList.remove('open');
  document.getElementById('drawer').classList.remove('open');
}
document.querySelectorAll('.tab').forEach(tab=>{
  tab.addEventListener('click',()=>{
    document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
    tab.classList.add('active');
    curWeek=tab.dataset.week;
    render();
  });
});
window.addEventListener('DOMContentLoaded',render);
</script>
</body>
</html>
