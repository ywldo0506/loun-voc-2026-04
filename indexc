*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Pretendard',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--bg);color:var(--text);font-size:14px;}
.header{background:var(--white);border-bottom:2px solid var(--green-light);padding:16px 28px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;box-shadow:0 1px 6px rgba(45,125,70,.08);}
.header-left{display:flex;align-items:center;gap:12px;}
.header-logo{width:8px;height:36px;background:linear-gradient(180deg,var(--green-mid),var(--green-dark));border-radius:4px;}
.header-title{font-size:18px;font-weight:800;color:var(--green-dark);}
.header-sub{font-size:12px;color:var(--text-muted);margin-top:2px;}
.badges{display:flex;gap:8px;}
.badge{font-size:12px;font-weight:600;padding:5px 12px;border-radius:20px;}
.badge-g{background:var(--green-light);color:var(--green-dark);}
.badge-r{background:var(--danger-light);color:var(--danger);}
.tabs{background:var(--white);border-bottom:1px solid var(--border);padding:0 28px;display:flex;}
.tab{padding:13px 22px;cursor:pointer;border-bottom:3px solid transparent;color:var(--text-muted);transition:all .15s;white-space:nowrap;display:flex;flex-direction:column;align-items:center;gap:2px;}
.tab .tl{font-size:13px;font-weight:600;}
.tab .td{font-size:10px;color:var(--text-sub);}
.tab:hover{color:var(--green);}
.tab.active{color:var(--green-dark);border-bottom-color:var(--green);background:var(--green-pale);}
.tab.active .tl{font-weight:800;}
.content{padding:20px 28px;max-width:1200px;}
.section{background:var(--white);border:1px solid var(--border);border-radius:12px;padding:18px 22px;margin-bottom:20px;}
.sec-title{font-size:14px;font-weight:800;color:var(--green-dark);margin-bottom:16px;display:flex;align-items:center;gap:10px;}
.sec-sub{font-size:11px;color:var(--text-muted);font-weight:400;background:var(--bg);padding:2px 8px;border-radius:10px;}
.chart-wrap{position:relative;height:280px;}
.cell-selector{display:flex;gap:10px;margin-bottom:0;}
.cell-btn{flex:1;background:var(--white);border:2px solid var(--border);border-radius:12px;padding:14px 16px;cursor:pointer;font-family:inherit;transition:all .15s;display:flex;align-items:center;justify-content:space-between;}
.cb-l{display:flex;align-items:center;gap:10px;}
.cb-dot{width:10px;height:10px;border-radius:50%;background:var(--border);}
.cb-name{font-size:15px;font-weight:800;color:var(--text-muted);}
.cb-r{text-align:right;}
.cb-avg{font-size:18px;font-weight:800;color:var(--text-muted);}
.cb-sub{font-size:10px;color:var(--text-sub);margin-top:2px;}
.cell-btn.active{border-color:var(--green);background:var(--green-pale);}
.cell-btn.active .cb-dot{background:var(--green);}
.cell-btn.active .cb-name,.cell-btn.active .cb-avg{color:var(--green-dark);}
table{width:100%;border-collapse:collapse;font-size:13px;}
thead th{background:var(--green-pale);padding:10px 12px;font-weight:700;font-size:11px;color:var(--green-dark);text-align:left;border-bottom:2px solid var(--green-light);letter-spacing:.3px;}
tbody td{padding:10px 12px;border-bottom:1px solid var(--border);vertical-align:middle;}
tbody tr:last-child td{border-bottom:none;}
tbody tr:hover{background:var(--green-pale);cursor:pointer;}
.store-nm{font-weight:700;}
.low-n{font-weight:800;color:var(--danger);}
.tot-n{color:var(--text-muted);font-size:12px;}
.bar-wrap{display:flex;align-items:center;gap:8px;}
.bar-bg{height:7px;border-radius:4px;background:var(--green-bar);}
.pct-n{font-size:12px;font-weight:800;min-width:38px;}
.pr{color:var(--danger);}.po{color:var(--warning);}.pg{color:var(--green);}
.avg-bad{color:var(--danger);font-weight:700;}
.avg-ok{color:var(--warning);font-weight:700;}
.avg-good{color:var(--green);font-weight:700;}
.dcu{font-size:11px;font-weight:700;color:var(--danger);}
.dcd{font-size:11px;font-weight:700;color:var(--green);}
.dce{font-size:11px;color:var(--text-sub);}
.rv-btn{font-size:11px;color:var(--green-dark);background:var(--green-light);border:none;padding:3px 8px;border-radius:6px;cursor:pointer;font-family:inherit;font-weight:600;}
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:200;}
.overlay.open{display:block;}
.drawer{position:fixed;right:0;top:0;bottom:0;width:500px;background:var(--white);z-index:201;overflow-y:auto;transform:translateX(100%);transition:transform .28s cubic-bezier(.4,0,.2,1);box-shadow:-6px 0 30px rgba(0,0,0,.14);}
.drawer.open{transform:translateX(0);}
.dh{padding:18px 22px;border-bottom:2px solid var(--green-light);display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:var(--white);z-index:10;}
.dh h3{font-size:14px;font-weight:800;color:var(--green-dark);flex:1;min-width:0;margin-right:8px;}
.dw-tag{font-size:11px;font-weight:700;background:var(--green-light);color:var(--green-dark);padding:3px 9px;border-radius:10px;white-space:nowrap;}
.dc-btn{cursor:pointer;background:none;border:none;font-size:22px;color:var(--text-muted);padding:2px 8px;border-radius:6px;flex-shrink:0;}
.db{padding:16px 22px;}
.rv{border:1px solid var(--border);border-radius:10px;padding:13px 15px;margin-bottom:10px;}
.rv-meta{display:flex;align-items:center;gap:8px;margin-bottom:9px;flex-wrap:wrap;}
.sc{font-size:12px;font-weight:800;padding:2px 9px;border-radius:12px;}
.sc1{background:#FEE2E2;color:#991B1B;}.sc2{background:#FEF9C3;color:#78350F;}
.rv-date{font-size:11px;color:var(--text-muted);}
.rv-txt{font-size:13px;line-height:1.7;word-break:keep-all;}
.no-rv{text-align:center;padding:48px 20px;color:var(--text-muted);}
@media(max-width:768px){.cell-selector{flex-direction:column;}.drawer{width:100%;}.content{padding:14px 16px;}}
</style>
</head>
